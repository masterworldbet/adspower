{
  "name": "masterbrowser",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && tsc && vite build --base=./",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis",
    "test:browser": "tsx --test --test-force-exit --test-timeout=60000 tests/browser.integration.ts",
    "package:portable": "npm run build && electron-builder --win zip"
  },
  "dependencies": {
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "electron": "^39.0.0"
  },
  "build": {
    "appId": "local.masterbrowser",
    "productName": "MasterBrowser",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  },
  "description": "Local desktop browser profile manager",
  "author": "MasterBrowser"
}
